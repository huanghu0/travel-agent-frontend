# 本配置假设平台会把：
#   https://ai-creator-show.eastmoney.com/ai-creator-service/rHFReMyqD4sL/xxx
# 转发为：
#   http://10.126.192.26:21818/xxx
# 即平台会剥离 /ai-creator-service/rHFReMyqD4sL 前缀。

upstream trip_planner_backend {
    server 10.126.192.26:8000;
    keepalive 32;
}

server {
    listen 21818;
    server_name _;

    root /opt/helloagents-trip-planner/frontend/dist;
    index index.html;
    charset utf-8;
    client_max_body_size 20m;

    # 后端 REST API 与任务 SSE 流。
    location ^~ /api/ {
        proxy_pass http://trip_planner_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";

        # 行程生成和 SSE 连接时间较长，必须关闭代理缓冲并放宽超时。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1200s;
        proxy_send_timeout 1200s;
        add_header X-Accel-Buffering no;
    }

    # Vite 产物带 hash，可以长期缓存。
    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Vue Router 使用 history 模式；文件不存在时回退到 index.html。
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
